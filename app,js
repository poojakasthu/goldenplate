// 9. CHANGE QUANTITY

function changeQuantity(item, amount) {

    item.quantity += amount;

    if (item.quantity <= 0) {

        cart = cart.filter(cartItem => cartItem !== item);

    }

    updateCart();

}


// 10. REMOVE ITEM

function removeItem(item) {

    cart = cart.filter(cartItem => cartItem !== item);

    updateCart();

    showToast("Item removed from cart!");

}


