// 15. CUSTOMIZE YOUR DISH

const customModal = document.getElementById("customModal");

const modalClose = document.getElementById("modalClose");

const customFoodName = document.getElementById("customFoodName");

const spiceLevel = document.getElementById("spiceLevel");

const customTotal = document.getElementById("customTotal");

const addonCheckboxes = document.querySelectorAll(".addon");

const addCustomized = document.getElementById("addCustomized");

let currentFood = "";

let currentPrice = 0;


function openCustomize(name, price) {

    currentFood = name;
    currentPrice = price;

    customFoodName.textContent = name;

    spiceLevel.value = "Medium";

    addonCheckboxes.forEach(addon => {
        addon.checked = false;
    });

    updateCustomTotal();

    customModal.classList.add("show");

    document.body.classList.add("cart-open");

}


function closeCustomize() {

    customModal.classList.remove("show");

    document.body.classList.remove("cart-open");

}


modalClose.addEventListener("click", closeCustomize);

customModal.addEventListener("click", event => {

    if (event.target === customModal) {

        closeCustomize();

    }

});


function updateCustomTotal() {

    let total = currentPrice;

    addonCheckboxes.forEach(addon => {

        if (addon.checked) {

            total += Number(addon.dataset.price);

        }

    });

    customTotal.textContent = `₹${total}`;

}


addonCheckboxes.forEach(addon => {

    addon.addEventListener("change", updateCustomTotal);

});


addCustomized.addEventListener("click", () => {

    const selectedAddons = [];

    let total = currentPrice;

    addonCheckboxes.forEach(addon => {

        if (addon.checked) {

            selectedAddons.push(addon.value);

            total += Number(addon.dataset.price);

        }

    });

    const spice = spiceLevel.value;

    const options = [
        "Spice: " + spice,
        ...selectedAddons
    ].join(", ");

    addToCart(currentFood, total, options);

    closeCustomize();

});


// 16. SPIN AND WIN

const wheel = document.getElementById("wheel");

const spinButton = document.getElementById("spinButton");

const spinResult = document.getElementById("spinResult");


const prizes = [

    { name: "5% OFF", discount: 5 },

    { name: "10% OFF", discount: 10 },

    { name: "Try Again", discount: 0 },

    { name: "FREE DESSERT", discount: 0 },

    { name: "₹50 OFF", discount: 50 },

    { name: "15% OFF", discount: 15 }

];


function checkSpinStatus() {

    const today = new Date().toLocaleDateString("en-CA");

    const alreadySpun = spinDate === today;

    spinButton.disabled = alreadySpun;

    spinButton.textContent = alreadySpun
        ? "COME BACK TOMORROW"
        : "SPIN NOW";

    if (alreadySpun) {

        spinResult.textContent =
            "You have already used today's spin!";

    }

}


let isSpinning = false;

let currentRotation = 0;

spinButton.addEventListener("click", () => {

    if (isSpinning) return;

    const today = new Date().toLocaleDateString("en-CA");

    if (spinDate === today) {

        showToast("You have already spun today!");

        return;

    }

    isSpinning = true;

    spinButton.disabled = true;

    spinButton.textContent = "SPINNING...";

    const prizeIndex = Math.floor(Math.random() * prizes.length);

    const prize = prizes[prizeIndex];

    // Each segment is 60 degrees.
    // Align the selected segment with the top pointer.

    const segmentCenter = prizeIndex * 60 + 30;

    const finalAngle = 360 - segmentCenter;

    const extraSpins = 6 * 360;

    currentRotation += extraSpins +
        ((finalAngle - currentRotation % 360 + 360) % 360);

    wheel.style.transform = `rotate(${currentRotation}deg)`;

    setTimeout(() => {

        spinDate = today;

        spinDiscount = Math.max(spinDiscount, prize.discount);

        saveRewards();

        isSpinning = false;

        checkSpinStatus();

        if (prize.name === "Try Again") {

            spinResult.textContent =
                "😅 Better luck next time!";

        } else if (prize.name === "FREE DESSERT") {

            spinResult.textContent =
                "🎉 You won a FREE DESSERT! Ask us to redeem your demo prize.";

        } else {

            spinResult.textContent =
                `🎉 Congratulations! You won ${prize.name}!`;

        }

        if (prize.discount > 0) {

            showToast(prize.name + " reward unlocked!");

        }

    }, 4200);

});


// 17. GOLDEN REWARDS DISPLAY

const rewardPointsDisplay =
    document.getElementById("rewardPoints");

const rewardLevel =
    document.getElementById("rewardLevel");

const pointsProgress =
    document.getElementById("pointsProgress");

const pointsMessage =
    document.getElementById("pointsMessage");


function updateRewards() {

    rewardPointsDisplay.textContent = rewardPoints;

    let level = "Golden Beginner";

    if (rewardPoints >= 500) {

        level = "👑 Golden Legend";

    } else if (rewardPoints >= 200) {

        level = "🥇 Golden Champion";

    } else if (rewardPoints >= 100) {

        level = "⭐ Golden Member";

    }

    rewardLevel.textContent = level;

    const progress = rewardPoints % 100;

    pointsProgress.style.width = progress + "%";

    const remaining = 100 - progress;

    pointsMessage.textContent =
        remaining + " more points to your next 100-point milestone!";

    saveRewards();

}


// 18. REDEEM GOLDEN POINTS

const redeemPoints = document.getElementById("redeemPoints");

redeemPoints.addEventListener("click", () => {

    if (rewardPoints < 100) {

        showToast("You need 100 points to redeem!");

        return;

    }

    rewardPoints -= 100;

    walletDiscount += 50;

    updateRewards();

    showToast("₹50 demo reward added to your wallet!");

});


// 19. CHECKOUT AND EARN POINTS

checkoutBtn.addEventListener("click", () => {

    if (cart.length === 0) {

        showToast("Your cart is empty!");

        return;

    }

    const subtotal = cart.reduce((sum, item) => {

        return sum + item.price * item.quantity;

    }, 0);

    const availableDiscount = walletDiscount + spinDiscount;

    const discount = Math.min(subtotal, availableDiscount);

    const finalTotal = subtotal - discount;

    const confirmed = confirm(

        `Order Summary\n\n` +
        `Subtotal: ₹${subtotal}\n` +
        `Discount: ₹${discount}\n` +
        `Final Total: ₹${finalTotal}\n\n` +
        `Place this demo order?`

    );

    if (!confirmed) return;


    // Earn 10 points for every ₹100 spent.

    const earnedPoints = Math.floor(finalTotal / 100) * 10;

    rewardPoints += earnedPoints;

    // Consume discounts.

    let remainingDiscount = discount;

    const walletUsed = Math.min(walletDiscount, remainingDiscount);

    walletDiscount -= walletUsed;

    remainingDiscount -= walletUsed;

    const spinUsed = Math.min(spinDiscount, remainingDiscount);

    spinDiscount -= spinUsed;


    cart = [];

    updateCart();

    updateRewards();

    closeCart();

    showToast(
        `Order placed! You earned ${earnedPoints} Golden Points!`
    );

    alert(
        `Thank you for ordering at The Golden Plate!\n\n` +
        `Amount paid: ₹${finalTotal}\n` +
        `Points earned: ${earnedPoints}\n` +
        `Total rewards: ${rewardPoints}`
    );

});


// 20. TABLE RESERVATION

const reservationForm =
    document.getElementById("reservationForm");

const bookingDate =
    document.getElementById("bookingDate");


function getLocalDate() {

    const date = new Date();

    return [
        date.getFullYear(),
        String(date.getMonth() + 1).padStart(2, "0"),
        String(date.getDate()).padStart(2, "0")
    ].join("-");

}

const localToday = getLocalDate();

bookingDate.min = localToday;

reservationForm.addEventListener("submit", async event => {

    event.preventDefault();

    const name =
        document.getElementById("customerName").value.trim();

    const email =
        document.getElementById("customerEmail").value.trim();

    const date = bookingDate.value;

    const time =
        document.getElementById("bookingTime").value;

    const guests =
        document.getElementById("guests").value;

    if (date < getLocalDate()) {
        showToast("Please select a valid date!");
        return;
    }

    try {

        const response = await fetch(API_URL, {
            method: "POST",
            body: JSON.stringify({
                action: "reservation",
                name: name,
                email: email,
                bookingDate: date,
                bookingTime: time,
                guests: guests
            })
        });

        const result = await response.json();

        if (!result.success) {
            throw new Error(result.message);
        }

        alert(
            `Reservation Confirmed!\n\n` +
            `Reservation ID: ${result.reservationId}\n` +
            `Name: ${name}\n` +
            `Date: ${date}\n` +
            `Time: ${time}\n` +
            `Guests: ${guests}`
        );

        reservationForm.reset();
        showToast("Reservation saved successfully!");

    } catch (error) {

        console.error("Reservation Error:", error);
        showToast("Reservation failed. Please try again.");

    }

});


