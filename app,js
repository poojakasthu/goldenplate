// 3. LOCAL STORAGE

function getSavedNumber(key) {
    const value = Number(localStorage.getItem(key));
    return Number.isFinite(value) && value >= 0 ? value : 0;
}

let rewardPoints = getSavedNumber("goldenPoints");

let walletDiscount = getSavedNumber("goldenDiscount");

let spinDate = localStorage.getItem("goldenSpinDate") || "";

let spinDiscount = getSavedNumber("goldenSpinDiscount");

function saveRewards() {
    localStorage.setItem("goldenPoints", rewardPoints);
    localStorage.setItem("goldenDiscount", walletDiscount);
    localStorage.setItem("goldenSpinDate", spinDate);
    localStorage.setItem("goldenSpinDiscount", spinDiscount);
}


// 4. TOAST NOTIFICATION

let toastTimer;

function showToast(message) {

    toast.textContent = message;
    toast.classList.add("show");

    clearTimeout(toastTimer);

    toastTimer = setTimeout(() => {
        toast.classList.remove("show");
    }, 2500);

}


